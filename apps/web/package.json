{
  "name": "datanav-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:core": "VITE_SURFACE=core vite",
    "dev:local": "DATANAV_API_PROXY=http://127.0.0.1:8010 vite",
    "build": "node scripts/check-labels.mjs && vite build",
    "build:image": "vite build",
    "preview": "vite preview",
    "build:core": "node scripts/check-labels.mjs && VITE_SURFACE=core vite build",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "check:labels": "node scripts/check-labels.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
