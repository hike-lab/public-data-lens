# docker compose용 환경변수 — 이 파일을 .env로 복사해 값 입력 (.env는 커밋 금지)

## 로컬 풀스택(docker-compose.yml — 웹 포함)용
# 교차 출처 허용 목록(쉼표 구분). 기본 비움 = 차단. 웹은 게이트웨이 뒤 동일 출처라 보통 불필요 —
# Vite dev 서버(5173) 등 별도 오리진에서 api를 직접 호출할 때만 해당 오리진을 지정한다.
DATANAV_CORS_ORIGINS=
DATANAV_RATE_LIMIT_PER_MIN=120

## 공개 배포(docker-compose.prod.yml — MCP 전용)용
# 게이트웨이 바인딩 주소·포트 — 기본 루프백(원 서버 직접 접근·TLS 우회 차단).
# LB가 다른 호스트에서 접근하면 GATEWAY_BIND를 이 호스트의 내부 IP로 지정한다.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8088
# [필수] TLS를 종단하는 LB/프록시의 내부 대역 CIDR — 쉼표로 다중 지정 가능. 미지정 시 기동 실패.
# 예: 10.0.0.0/8,100.64.0.0/10  (직접 노출·LB 없음이면 127.0.0.1 = no-op)
GATEWAY_REAL_IP_FROM=
# [필수] 서비스 도메인(쉼표 구분) — MCP Host 헤더 검증(DNS 리바인딩 보호). 미지정 시 기동 실패.
DATANAV_MCP_ALLOWED_HOSTS=service.datahub.kr
# 관측 예시값 공개(S0-2 법적 확인 후 1로) — 기본 비공개. api·mcp 양쪽에 전달된다
DATANAV_EXAMPLES_PUBLIC=0
# §10 익명 사용 로그(1=기록, 0=끔)
DATANAV_USAGE_LOG=1
# 익명 식별자용 HMAC 비밀키(임의 긴 문자열) — 미지정 시 데이터 볼륨에 1회 생성해 영속
# (재시작에도 캡·지표 연속). 다중 인스턴스 공유 등 명시 관리가 필요하면 지정: openssl rand -hex 32
DATANAV_ANON_HMAC_KEY=
# 월간 빌드 SHACL 검증 표본 수(0=전수)
DATANAV_SHACL_SAMPLE=500

