{
  "suite": "snapshot-export-artifacts",
  "title": "발행자 내보내기 아티팩트 — 무엇이 실질 변경이고 무엇이 표기 요동인가",
  "rules": [
    "normalize-date-v1.0",
    "normalize-empty-v1.0",
    "diff-v1.1",
    "issue-detect-v1.1"
  ],
  "adr": [
    "ADR-016",
    "ADR-018"
  ],
  "provenance": "2026-06 / 2026-07 초판 / 2026-07 수정판 / 2026-08 API 합성본 전수 대조(각 96,056 / 96,110 / 96,110 / 96,209행)",
  "cases": [
    {
      "id": "date-serial-restored",
      "given": {
        "column": "등록일",
        "value": "41249"
      },
      "expect": {
        "created_date": "2012-12-06",
        "issue": "EXCEL_SERIAL_DATE_ARTIFACT"
      },
      "why": "엑셀 1900 체계 일련번호. 2026-07 회차 API 11,960행에서 관측되었고 2026-06 회차와 11,929건 전건 일치로 환산 정확도가 검증됐다. 환산은 하되 관찰로 남긴다 — 조용히 고치면 재발을 놓친다."
    },
    {
      "id": "year-like-value-not-a-serial",
      "given": {
        "column": "등록일",
        "value": "2026"
      },
      "expect": {
        "created_date": "2026",
        "issue": null
      },
      "why": "연도 4자리를 일련번호로 오인하면 2026 → 1905-07-18이 된다. 범위 하한 30000이 이를 막는다."
    },
    {
      "id": "unparseable-date-kept-and-observed",
      "given": {
        "column": "수정일",
        "value": "2026.07.31"
      },
      "expect": {
        "modified_date": "2026.07.31",
        "issue": "UNPARSEABLE_DATE_FORMAT"
      },
      "why": "해석 못 하는 값을 버리지 않는다(§8 원본값 추적). 판단 불가는 나쁨이 아니며, 관찰로 드러내는 것이 옳다."
    },
    {
      "id": "description-newline-churn-is-not-modified",
      "given": {
        "prev": "* 서울시농수산식품공사에서 제공중인 일일등락품목 API 입니다.* 신청시 사용자 인증번호",
        "curr": "* 서울시농수산식품공사에서 제공중인 일일등락품목 API 입니다.\n* 신청시 사용자 인증번호"
      },
      "expect": {
        "status": null,
        "changed_fields": []
      },
      "why": "2026-06 회차는 줄바꿈을 제거하고 2026-07 회차는 보존한다(0건 → 5,941건). 글자는 한 자도 바뀌지 않았다. 원시 비교는 6,202건을 거짓 MODIFIED로 만든다."
    },
    {
      "id": "description-content-change-is-modified",
      "given": {
        "prev": "첫 문장입니다.",
        "curr": "첫 문장입니다. 셋째 문장 추가."
      },
      "expect": {
        "status": "MODIFIED",
        "changed_fields": [
          "description"
        ]
      },
      "why": "공백 둔감이 실질 변경을 삼켜서는 안 된다. 2026-06→07의 실질 설명 변경은 1,730건이며 이 수치가 보존되어야 한다."
    },
    {
      "id": "format-case-churn-is-not-modified",
      "given": {
        "prev": "CSV",
        "curr": "csv"
      },
      "expect": {
        "status": null,
        "changed_fields": []
      },
      "why": "normalize_formats가 대문자 토큰으로 환산한다. 원시값 추적은 확장자 표기 정책 변경 한 번에 전 행을 MODIFIED로 만든다."
    },
    {
      "id": "empty-marker-churn-is-not-a-fill-rate-change",
      "given": {
        "column": "파일데이터명",
        "prev": "",
        "curr": "-"
      },
      "expect": {
        "file_data_name": null,
        "fill_rate_delta_pp": 0.0
      },
      "why": "is_empty()의 EMPTY에 '-'가 포함된다. 원시 문자열로 채움률을 세면 2026-07 회차가 12.2pp '개선'된 것으로 보이지만 실제 변화는 없다. 수용 게이트는 정규화 후 값으로 센다."
    },
    {
      "id": "counter-decrease-blocks-acceptance",
      "given": {
        "column": "조회수",
        "prev": 12627,
        "curr": 12265
      },
      "expect": {
        "gate": "BLOCK"
      },
      "why": "조회수는 누적값이다. 2026-08 API 합성본은 96,080행 전부가 2026-07보다 낮아, 파일명과 달리 7월 중순 빈티지임이 드러났다. 카운터 단조성 하나가 이 판정을 자동화한다."
    },
    {
      "id": "license-vocabulary-recoding-blocks-acceptance",
      "given": {
        "column": "이용허락범위",
        "prev": "공공저작물 : 출처표시, 상업적 이용금지, 변경금지 (제 4유형)",
        "curr": "이용허락범위 제한 없음"
      },
      "expect": {
        "gate": "BLOCK"
      },
      "why": "2026-08 API 합성본에서 조건부 라이선스 9,593건이 '제한 없음'으로 반전됐고 그중 2,644건은 비영리 조건이 사라졌다. 어휘 집합의 과반 소멸을 차단 조건으로 둔다. 값이 없는 것보다 틀린 값이 위험하다."
    },
    {
      "id": "missing-column-blocks-acceptance",
      "given": {
        "column": "공간범위",
        "prev_fill_pct": 6.2,
        "curr_fill_pct": 0.0
      },
      "expect": {
        "gate": "BLOCK",
        "collateral": "region evidence EXPLICIT_SPATIAL 3,732 → 0"
      },
      "why": "셀 수로는 전체의 6%지만 EXPLICIT_SPATIAL(신뢰도 0.95)의 유일한 근거원이다. 정보량과 계약 영향은 비례하지 않는다."
    },
    {
      "id": "formula-error-residue-is-no-value",
      "given": {
        "column": "설명",
        "value": "ME?"
      },
      "expect": {
        "description": null,
        "issue": "EXCEL_FORMULA_ERROR_ARTIFACT",
        "completeness": "감점"
      },
      "why": "2026-07 수정판 실측 74건. '-'로 시작하는 셀을 엑셀이 수식으로 해석해 #NAME?가 되고, 발행자 수정에서 앞 3자가 절단됐다(2026-06 원문 11,769자 소실). 'ME?'를 데이터 설명으로 서빙하는 것보다 값 없음이 정직하다. 미기재와 파괴는 판정이 같고 원인이 다르므로 관찰로 구별한다."
    },
    {
      "id": "formula-error-lookalike-in-prose-is-content",
      "given": {
        "column": "설명",
        "value": "#NAME? 오류의 원인과 해결 방법을 정리한 자료"
      },
      "expect": {
        "description": "원문 유지",
        "issue": null
      },
      "why": "전체 셀 정확 일치만 판정한다. 부분 일치로 확장하면 오류를 설명하는 정상 문서를 삼킨다."
    },
    {
      "id": "do-not-restore-from-previous-snapshot",
      "given": {
        "column": "설명",
        "prev_snapshot": "- 한국법제연구원에서 발간하고 있는 연속간행물…",
        "curr_snapshot": "ME?"
      },
      "expect": {
        "description": null,
        "restored_from_prev": false
      },
      "why": "날짜 환산은 가역적 인코딩 복원(41249 ↔ 2012-12-06, 정보 손실 없음)이고 이것은 소실된 원문의 대체다. 스냅샷은 그 시점의 관찰이어야 하며, 다른 시점의 값을 몰래 채우면 스냅샷이 아니다."
    },
    {
      "id": "text-collapse-excludes-emptied-cells",
      "given": {
        "prev": "가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가가",
        "curr": ""
      },
      "expect": {
        "gate_check": "값 회귀",
        "not_reported_by": "원문 급감"
      },
      "why": "두 검사가 같은 셀을 이중 보고하지 않는다. 정교화 전 116건 → 후 3건, 남은 3건은 전부 정상 재작성이었다(인천광역시 중구 → 영종구 행정구역 개편 등)."
    },
    {
      "id": "serial-date-restoration-matches-publisher",
      "given": {
        "column": "등록일",
        "value": "41249"
      },
      "expect": {
        "created_date": "2012-12-06"
      },
      "why": "2026-08-24 수령한 발행자 수정본과 11,960/11,960(100.00%) 일치. 1899-12-30 원점 가설의 독립 검증이다."
    },
    {
      "id": "newline-policy-oscillates-across-releases",
      "given": {
        "column": "설명",
        "newline_rows_by_release": {
          "2026-06": 0,
          "2026-07 초판": 5961,
          "2026-07 수정판": 0
        }
      },
      "expect": {
        "diff_status": null
      },
      "why": "발행자 정책은 줄바꿈 제거이며 초판만 예외였다. 회차마다 흔들리므로 공백 둔감 비교가 없으면 그때마다 약 6천 건이 거짓 MODIFIED가 된다."
    }
  ]
}
